{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@anvia/core": "^1.17.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.1"
  }
}
